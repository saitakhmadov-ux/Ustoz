# ---- Ustoz backend muhit o'zgaruvchilari ----
# Bu faylni nusxalab .env yarating (mahalliy) yoki qiymatlarni Railway'ga kiriting.

# Server porti (Railway avtomatik PORT beradi — o'zgartirmang)
PORT=5000
NODE_ENV=production

# Frontend manzili (CORS uchun). Bir nechta bo'lsa vergul bilan:
# CLIENT_URL=http://localhost:3000,https://ustoz.vercel.app
CLIENT_URL=https://SIZNING-FRONTEND.vercel.app

# PostgreSQL ulanish satri.
# Railway'da PostgreSQL qo'shsangiz, ${{ Postgres.DATABASE_URL }} bilan ulang.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT — MUHIM: kuchli tasodifiy satr qo'ying (kamida 32 belgi)
JWT_SECRET=BU_YERGA_KUCHLI_MAXFIY_KALIT_QOYING
JWT_EXPIRES_IN=7d

# Boshlang'ich admin (seed ishga tushganda yaratiladi)
ADMIN_EMAIL=admin@ustoz.uz
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Bosh Admin

# To'lov (hozircha mock — haqiqiy pul o'tmaydi)
PAYMENT_MOCK=true

# Email — ro'yxatdan o'tishni tasdiqlash va parolni tiklash kodlari shu orqali ketadi.
# EMAIL_MOCK=true bo'lsa xat yuborilmaydi, kod konsolga chiqadi (faqat ishlab chiqish uchun).
#
# Gmail bilan sozlash:
#   1) https://myaccount.google.com/apppasswords — 16 belgili App password oling
#      (avval akkauntda 2 bosqichli tasdiqlash yoqilgan bo'lishi shart)
#   2) SMTP_USER va SMTP_PASS ni to'ldiring, EMAIL_MOCK=false qiling
#   3) Tekshirish:  npm run mail:test [email]
#
# Eslatma: bepul Gmail kuniga ~500 ta xat bilan cheklangan. O'sish bo'lsa
# Brevo / Resend / Mailgun kabi xizmatga o'tish kerak (kod o'zgarmaydi, faqat SMTP_*).
EMAIL_MOCK=true
EMAIL_FROM="Ustoz <no-reply@ustoz.uz>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
