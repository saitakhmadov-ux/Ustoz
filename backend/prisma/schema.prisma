// Ustoz — Onlayn IT ta'lim platformasi
// Prisma sxemasi (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enumlar ----------

enum Role {
  ADMIN // bosh admin — to'liq huquq
  INSTRUCTOR // ustoz admin — faqat biriktirilgan kurs(lar)i kontenti
  USER
}

enum MaterialType {
  VIDEO
  PDF
}

enum Level {
  BEGINNER // boshlang'ich
  INTERMEDIATE // o'rta
  ADVANCED // yuqori
}

enum PaymentProvider {
  CLICK
  PAYME
}

enum PaymentStatus {
  PENDING // kutilmoqda
  PAID // to'langan
  FAILED // muvaffaqiyatsiz
}

// Ustoz daromadining manbasi — taqsimot ulushi shunga bog'liq.
enum EarningSource {
  ORGANIC // oddiy sotuv — ustozga sof foydaning 40% i
  REFERRAL // ustozning promo kodi orqali — ustozga sof foydaning 60% i
}

// Bir martalik kodning maqsadi
enum VerificationPurpose {
  EMAIL_VERIFY // ro'yxatdan o'tishda emailni tasdiqlash
  PASSWORD_RESET // parolni tiklash
}

// Ustoz hisobiga o'tkazma holati
enum PayoutStatus {
  PENDING // rejalashtirilgan, hali o'tkazilmagan
  PAID // hisobga o'tkazilgan
}

// ---------- Modellar ----------

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  avatarUrl    String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Telefon raqam — ixtiyoriy va noyob (+998XXXXXXXXX ko'rinishida saqlanadi).
  // Hozircha profil ma'lumoti; tasdiqlash keyingi bosqichda (Telegram/SMS) qo'shiladi.
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  // Email tasdiqlangan sana. null = tasdiqlanmagan, akkaunt cheklangan.
  emailVerifiedAt DateTime?

  // Telegram bot bilan bog'lanish. chatId noyob — bitta Telegram akkaunt
  // faqat bitta Ustoz hisobiga ulanadi. Ulash saytdan boshlanadi (bir martalik
  // havola), shuning uchun begona odam o'zini birovning hisobiga ulay olmaydi.
  telegramChatId   String?   @unique
  telegramUsername String? // @nik — faqat ko'rsatish uchun
  telegramLinkedAt DateTime?

  // Kunlik progress eslatmasi (Telegram). Tugatilmagan kurslar bo'yicha kuniga
  // bir marta yuboriladi; sertifikat olingach o'sha kurs ro'yxatdan chiqadi.
  progressPingAt  DateTime? // oxirgi eslatma vaqti — kuniga bittadan oshmasligi uchun
  progressPingOff Boolean   @default(false) // foydalanuvchi /kunlik bilan o'chirgan

  verificationCodes VerificationCode[]
  telegramLinks     TelegramLink[]

  enrollments  Enrollment[]
  payments     Payment[]
  certificates Certificate[]
  progress     LessonProgress[]
  taskProgress TaskProgress[] // vazifa-darajali progress
  quizAttempts QuizAttempt[] // test urinishlari (kuldown)
  taughtCourses Course[] @relation("CourseInstructor") // ustoz sifatida biriktirilgan kurslar

  notifications     Notification[] @relation("UserNotifications") // qabul qilingan xabarlar
  sentNotifications Notification[] @relation("SentNotifications") // yuborgan xabarlar (admin/ustoz)
  reviews           Review[] // qoldirgan baholar
  aiUsages          AiUsage[] // AI Ustozdan foydalanish tarixi

  // Ustoz (INSTRUCTOR) daromadi bilan bog'liq
  promoCodes     PromoCode[] // yaratgan promo kodlari
  earnings       Earning[] // sotuvlardan ishlagan daromadlari
  payouts        Payout[] @relation("InstructorPayouts") // hisobiga o'tkazilgan summalar
  createdPayouts Payout[] @relation("PayoutCreatedBy") // admin sifatida kiritgan o'tkazmalar

  // Kunlik eslatma vazifasi har soatda shu shart bo'yicha qidiradi —
  // foydalanuvchilar ko'payganda butun jadval skanerlanmasin
  @@index([progressPingOff, progressPingAt])
}

// Bir martalik tasdiqlash kodlari: emailni tasdiqlash va parolni tiklash.
// Kod ochiq saqlanmaydi — faqat hash. Muddati o'tgan va ishlatilgan kodlar
// keyingi kod so'ralganda tozalanadi.
model VerificationCode {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   VerificationPurpose
  codeHash  String
  expiresAt DateTime
  attempts  Int                 @default(0) // noto'g'ri urinishlar soni
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

// Telegram akkauntini ulash uchun bir martalik havola tokeni.
// Foydalanuvchi saytda "Telegram'ga ulash" ni bosadi -> token yaratiladi ->
// t.me/<bot>?start=<token> havolasi ochiladi -> bot tokenni tanib, chatId ni
// hisobga bog'laydi. Token ochiq saqlanmaydi: bazada faqat sha256 hash turadi
// (bot tokenni hash bo'yicha topadi, shuning uchun bcrypt emas — sha256).
model TelegramLink {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String? // emoji yoki ikon nomi
  createdAt   DateTime @default(now())

  courses Course[]
}

model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  thumbnail   String? // rasm URL
  authorName  String
  price       Int      @default(0) // so'mda (tiyinsiz)
  isFree      Boolean  @default(false)
  level       Level    @default(BEGINNER)
  // Kursdan foydalanish muddati (oylarda). Bosh admin belgilaydi.
  // null bo'lsa — daraja bo'yicha standart qo'llanadi (BEGINNER 1, INTERMEDIATE 2, ADVANCED 3).
  accessMonths Int?
  // Kod maydoni (playground) yoqilganmi — dasturlash kurslari uchun. Admin belgilaydi.
  // false bo'lsa foydalanuvchiga "bu kursda ishlamaydi" xabari ko'rsatiladi.
  codePlayground Boolean @default(false)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Kursga biriktirilgan ustoz admin (ixtiyoriy). Ustoz o'chirilsa kurs qoladi.
  instructorId String?
  instructor   User?   @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)

  sections     Section[]
  enrollments  Enrollment[]
  payments     Payment[]
  certificates Certificate[]
  reviews      Review[]
  aiUsages     AiUsage[]
  promoCodes   PromoCode[] // shu kursga biriktirilgan promo kodlar
  earnings     Earning[] // shu kurs sotuvidan yozilgan daromadlar

  @@index([categoryId])
  @@index([instructorId])
  // Ommaviy ro'yxatlar va bot katalogi doim `published: true` bo'yicha filtrlaydi
  @@index([published, createdAt])
}

model Section {
  id       String @id @default(cuid())
  title    String
  order    Int    @default(0)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id            String  @id @default(cuid())
  title         String
  order         Int     @default(0)
  videoUrl      String? // YouTube/Vimeo yoki fayl URL
  content       String? @db.Text // matnli material (HTML/markdown)
  isFreePreview Boolean @default(false) // bepul ko'rish mumkinmi
  sectionId     String
  section       Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  // Test (quiz) sozlamalari — darsda savollar bo'lsa qo'llanadi.
  // Bazadan tasodifiy `quizDraw` ta savol beriladi (bo'lim testi 10, yakuniy test 40).
  // Test foydalanuvchiga faqat baza kamida 2×quizDraw ta savolga to'lganda ochiladi.
  quizDraw          Int @default(10) // nechta savol beriladi
  quizPassPercent   Int @default(60) // o'tish chegarasi (%)
  quizTimePerQ      Int @default(20) // har savolga soniya
  quizCooldownHours Int @default(3) // yiqilganda qayta urinishgacha soat

  questions    QuizQuestion[]
  progress     LessonProgress[]
  taskProgress TaskProgress[]
  materials    LessonMaterial[]
  quizAttempts QuizAttempt[]

  @@index([sectionId])
}

// Darsga biriktirilgan qo'shimcha materiallar (video yoki PDF).
// url — serverga yuklangan fayl yo'li (/uploads/...) yoki tashqi havola.
model LessonMaterial {
  id        String       @id @default(cuid())
  lessonId  String
  lesson    Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type      MaterialType
  title     String
  url       String
  createdAt DateTime     @default(now())

  @@index([lessonId])
}

model QuizQuestion {
  id           String   @id @default(cuid())
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question     String
  imageUrl     String? // savolga biriktirilgan skrinshot/rasm (/uploads/... yoki tashqi havola)
  options      String[] // variantlar
  correctIndex Int // to'g'ri javob indeksi (0 dan boshlab)

  @@index([lessonId])
}

// Foydalanuvchining test urinishi — kuldown (3 soat) va urinishlar tarixi uchun.
// Yiqilgan (passed=false) oxirgi urinishdan keyin quizCooldownHours davomida qayta topshirib bo'lmaydi.
model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  correct   Int // to'g'ri javoblar soni
  total     Int // berilgan savollar soni
  score     Int // foiz (0..100)
  passed    Boolean
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
}

model Enrollment {
  id        String    @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime  @default(now())
  // Kursdan foydalanish muddati tugaydigan sana. Kurs qiyinchilik darajasiga
  // qarab yoziluvda hisoblanadi (BEGINNER 1 oy, INTERMEDIATE 2 oy, ADVANCED 3 oy).
  // null = eski (muddatsiz) yozilishlar bilan mosligi uchun.
  expiresAt DateTime?
  // Muddat tugashi haqida ogohlantirish qachon yuborilgan. Har safar qayta
  // yozilganda null ga qaytariladi — yangi muddat uchun yangi ogohlantirish.
  expiryWarnedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  // Muddat bo'yicha vazifalar (accessExpiry ogohlantirishi, kunlik progress
  // eslatmasi) butun jadvalni skanerlamasin
  @@index([expiresAt])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

// Dars ichidagi alohida vazifalar bajarilishini kuzatadi (nozik/vazifa-darajali progress).
// taskKey — darsning bitta vazifasini bildiradi: `video:<lessonId>`, `content:<lessonId>`,
// `material:<materialId>`, `quiz:<lessonId>` yoki `done:<lessonId>` (komponentsiz dars).
// Darsning barcha vazifalari bajarilganda LessonProgress.completed = true bo'ladi.
model TaskProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  taskKey     String
  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, taskKey])
  @@index([userId])
  @@index([lessonId])
}

model Payment {
  id            String          @id @default(cuid())
  userId        String
  courseId      String
  amount        Int // haqiqatda to'langan summa (chegirmadan KEYIN), so'mda
  provider      PaymentProvider
  status        PaymentStatus   @default(PENDING)
  transactionId String? // provayder tranzaksiya ID (mock)
  createdAt     DateTime        @default(now())

  // Promo kod bilan xarid qilingan bo'lsa — kod va chegirma tafsilotlari.
  // originalAmount — chegirmadan OLDINGI kurs narxi (chek va hisobot uchun).
  promoCodeId    String?
  promoCode      PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  discountPct    Int        @default(0)
  originalAmount Int? // null = chegirma bo'lmagan (amount bilan bir xil)

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  earning Earning?

  @@index([userId])
  @@index([courseId])
  @@index([promoCodeId])
}

// Ustozning promo kodi — o'quvchi olib kelish uchun. Kod FAQAT shu ustozga
// biriktirilgan kurslarda amal qiladi. courseId null bo'lsa — ustozning barcha
// kurslariga, aks holda faqat bitta kursga.
model PromoCode {
  id           String   @id @default(cuid())
  code         String   @unique // katta harflarda saqlanadi, masalan "ALISHER10"
  instructorId String
  instructor   User     @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  courseId     String? // null = ustozning barcha kurslari
  course       Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  discountPct  Int      @default(0) // o'quvchiga beriladigan chegirma (0..maxDiscountPct)
  active       Boolean  @default(true)
  // Amal muddati. null = muddatsiz (doimiy). Sana o'tgach kod ishlamaydi.
  expiresAt    DateTime?
  // Foydalanish limiti — nechta to'langan xaridda ishlatilishi mumkin.
  // null = cheksiz. Hisob PAID holatdagi to'lovlar bo'yicha yuritiladi.
  maxUses      Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments Payment[]
  earnings Earning[]

  @@index([instructorId])
  @@index([courseId])
}

// Bitta to'langan xariddan ustozga tegishli daromad yozuvi.
// MUHIM: foizlar (taxPct/sharePct) yozuv yaratilgan paytdagi qiymat bilan
// SAQLANADI. Keyinchalik admin foizni o'zgartirsa ham o'tgan oylardagi
// maosh o'zgarmaydi — hisobot barqaror qoladi.
model Earning {
  id           String @id @default(cuid())
  paymentId    String @unique // bitta to'lovdan bitta daromad yozuvi (idempotent)
  payment      Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   User   @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  grossAmount      Int // to'langan summa (chegirmadan keyin)
  taxAmount        Int // ushlab qolingan soliq
  netAmount        Int // gross - tax (sof foyda)
  instructorAmount Int // ustoz ulushi
  platformAmount   Int // tizim ulushi (net - instructorAmount)

  taxPct   Int // snapshot: o'sha paytdagi soliq foizi
  sharePct Int // snapshot: ustozning sof foydadan ulushi (40 yoki 60)

  source      EarningSource
  promoCodeId String?
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([instructorId, createdAt])
  @@index([courseId])
  @@index([createdAt])
}

// Ustoz hisobiga HAQIQATDA o'tkazilgan summa. Bosh admin kiritadi.
// Ustozning kutilayotgan balansi = jami Earning.instructorAmount - jami PAID Payout.amount
model Payout {
  id           String       @id @default(cuid())
  instructorId String
  instructor   User         @relation("InstructorPayouts", fields: [instructorId], references: [id], onDelete: Cascade)
  amount       Int // so'mda
  status       PayoutStatus @default(PAID)
  method       String? // karta / bank / naqd
  note         String? // izoh (masalan "2026-yil iyul oyi uchun")
  periodFrom   DateTime? // qaysi davr uchun (ixtiyoriy)
  periodTo     DateTime?
  paidAt       DateTime? // hisobga o'tgan sana
  createdById  String? // kim kiritgan (admin); o'chirilsa null
  createdBy    User?    @relation("PayoutCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([instructorId, createdAt])
}

// Foydalanuvchining kursga qo'ygan bahosi (yulduz reyting + ixtiyoriy izoh)
// Har bir foydalanuvchi bitta kursga bitta baho qoldiradi (unique).
model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating    Int // 1..5 yulduz
  comment   String?  @db.Text // ixtiyoriy sharh
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
}

// Foydalanuvchiga yuborilgan xabar/bildirishnoma (bir tomonlama: admin/ustoz -> foydalanuvchi)
model Notification {
  id        String   @id @default(cuid())
  userId    String // qabul qiluvchi
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  senderId  String? // yuboruvchi (admin/ustoz); o'chirilsa null bo'ladi
  sender    User?    @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)
  title     String
  body      String   @db.Text
  read      Boolean  @default(false)
  emailSent Boolean  @default(false) // email ham yuborilganmi (mock/haqiqiy)
  telegramSent Boolean @default(false) // Telegram botga ham yuborilganmi
  createdAt DateTime @default(now())

  // Ro'yxat har doim "userId + eng yangilari" tartibida o'qiladi
  @@index([userId, createdAt])
  @@index([senderId])
  // Tozalash vazifasi eskilarini shu bo'yicha topadi
  @@index([createdAt])
}

// Sayt sozlamalari — key/value (value ichida JSON). Masalan bosh sahifa hero rasmlari.
// key "hero" -> { images: string[], intervalSec: number }
// key "home_content" -> { heroTitle, heroSubtitle, ctaTitle, ctaSubtitle, footerText }
// key "ai_config" -> { apiKey, model, customInstructions, enabled }
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text // JSON matn
  updatedAt DateTime @updatedAt
}

// AI Ustoz mentoridan foydalanish jurnali — analitika va foydalilik bahosi uchun.
// Har bir savol bitta yozuv. helpful — foydalanuvchi 👍/👎 fikri (null = fikr bildirilmagan).
model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  courseId  String?
  lessonId  String?
  question  String   @db.Text // foydalanuvchi savoli (qisqartirilgan)
  hasCode   Boolean  @default(false) // playground kodi biriktirilganmi
  hasError  Boolean  @default(false) // konsol xatosi biriktirilganmi
  helpful   Boolean? // 👍 true / 👎 false / null = fikr yo'q
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([courseId])
  @@index([createdAt])
}

model Certificate {
  id       String   @id @default(cuid())
  userId   String
  courseId String
  serial   String   @unique // sertifikat raqami
  issuedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  // Kurs kesimida qidiriladi (ustoz paneli, kunlik eslatma, admin hisobotlari)
  @@index([courseId])
}
